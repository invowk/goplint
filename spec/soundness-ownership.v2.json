{
  "format_version": 2,
  "rules": [
    { "pattern": ".agents/**", "class": "documentation" },
    { "pattern": ".github/workflows/**", "class": "harness" },
    { "pattern": ".pre-commit-config.yaml", "class": "harness" },
    { "pattern": "AGENTS.md", "class": "documentation" },
    { "pattern": "Makefile", "class": "harness" },
    { "pattern": "cmd/**", "class": "consumer" },
    { "pattern": "docs/goplint/**", "class": "documentation" },
    { "pattern": "go.mod", "class": "consumer" },
    { "pattern": "go.sum", "class": "consumer" },
    { "pattern": "internal/**", "class": "consumer" },
    { "pattern": "openspec/changes/**", "class": "documentation" },
    { "pattern": "openspec/changes/archive/2026-07-19-close-goplint-soundness-review-gaps/evidence/**", "class": "analyzer-semantics" },
    { "pattern": "openspec/changes/archive/2026-07-19-close-residual-goplint-soundness-gaps/evidence/**", "class": "analyzer-semantics" },
    { "pattern": "openspec/specs/goplint-analysis-soundness/**", "class": "analyzer-semantics" },
    { "pattern": "openspec/specs/goplint-soundness-assurance/**", "class": "analyzer-semantics" },
    { "pattern": "openspec/specs/lint-tooling-quality-gates/**", "class": "analyzer-semantics" },
    { "pattern": "pkg/**", "class": "consumer" },
    { "pattern": "tools/goplint/**", "class": "analyzer-semantics" },
    { "pattern": "tools/goplint/AGENTS.md", "class": "documentation" },
    { "pattern": "tools/goplint/CLAUDE.md", "class": "documentation" },
    { "pattern": "tools/goplint/README.md", "class": "documentation" },
    { "pattern": "tools/goplint/cmd/soundness-gate/**", "class": "harness" },
    { "pattern": "tools/goplint/cmd/soundness-report-compare/**", "class": "harness" },
    { "pattern": "tools/goplint/internal/soundnessgate/**", "class": "harness" },
    { "pattern": "tools/goplint/scripts/**", "class": "harness" }
  ]
}
