{
  "format_version": 2,
  "rules": [
    { "pattern": ".github/**", "class": "harness" },
    { "pattern": ".gitignore", "class": "harness" },
    { "pattern": ".golangci.toml", "class": "harness" },
    { "pattern": ".pre-commit-config.yaml", "class": "harness" },
    { "pattern": "AGENTS.md", "class": "documentation" },
    { "pattern": "CLAUDE.md", "class": "documentation" },
    { "pattern": "LICENSE", "class": "harness" },
    { "pattern": "Makefile", "class": "harness" },
    { "pattern": "README.md", "class": "documentation" },
    { "pattern": "baseline.toml", "class": "consumer" },
    { "pattern": "bench/**", "class": "analyzer-semantics" },
    { "pattern": "cmd/**", "class": "analyzer-semantics" },
    { "pattern": "cmd/soundness-gate/**", "class": "harness" },
    { "pattern": "cmd/soundness-report-compare/**", "class": "harness" },
    { "pattern": "docs/goplint/**", "class": "documentation" },
    { "pattern": "exceptions.toml", "class": "consumer" },
    { "pattern": "go.mod", "class": "analyzer-semantics" },
    { "pattern": "go.sum", "class": "analyzer-semantics" },
    { "pattern": "goplint/**", "class": "analyzer-semantics" },
    { "pattern": "inconclusive_orchestration_test.go", "class": "analyzer-semantics" },
    { "pattern": "internal/**", "class": "analyzer-semantics" },
    { "pattern": "internal/soundnessgate/**", "class": "harness" },
    { "pattern": "main.go", "class": "analyzer-semantics" },
    { "pattern": "main_findings_test.go", "class": "analyzer-semantics" },
    { "pattern": "main_parse_test.go", "class": "analyzer-semantics" },
    { "pattern": "main_test.go", "class": "analyzer-semantics" },
    { "pattern": "scripts/**", "class": "harness" },
    { "pattern": "spec/**", "class": "analyzer-semantics" },
    { "pattern": "testdata/**", "class": "analyzer-semantics" }
  ]
}
