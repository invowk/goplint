{
  "format_version": 4,
  "ownership_manifest_path": "spec/soundness-ownership.v2.json",
  "inputs": [
    {
      "name": "benchmark-thresholds",
      "path": "bench/thresholds.toml"
    },
    {
      "name": "evidence-index",
      "path": "docs/goplint/evidence-index.md"
    },
    {
      "name": "semantic-reference",
      "path": "docs/goplint/current-techniques-and-semantics.md"
    },
    {
      "name": "mutation-manifest",
      "path": "testdata/mutation/soundness-mutants-v2.json"
    },
    {
      "name": "mutation-profile",
      "path": "testdata/mutation/profiles/blocking-v2.json"
    },
    {
      "name": "protocol-oracle-bounds",
      "path": "spec/protocol-oracle-bounds.v1.json"
    },
    {
      "name": "soundness-ownership",
      "path": "spec/soundness-ownership.v2.json"
    },
    {
      "name": "audit-matrix",
      "path": "spec/evidence/audit-matrix.v1.json"
    }
  ],
  "toolchain": [
    {
      "name": "git",
      "command": [
        "git",
        "--version"
      ],
      "required_version_re": "^git version 2\\.55\\.0$"
    },
    {
      "name": "go",
      "command": [
        "go",
        "version"
      ],
      "required_version_re": "^go version go1\\.27\\.[0-9]+ linux/amd64$"
    },
    {
      "name": "golangci-lint",
      "command": [
        "./scripts/golangci-lint.sh",
        "version"
      ],
      "required_version_re": "^golangci-lint has version 2\\.13\\.1 .*$"
    },
    {
      "name": "make",
      "command": [
        "make",
        "--version"
      ],
      "required_version_re": "^GNU Make 4\\.[0-9]+(\\.[0-9]+)?"
    }
  ],
  "task_ledgers": [
    {
      "name": "bootstrap-standalone-goplint",
      "path": "docs/ledgers/bootstrap-standalone-goplint/tasks.md",
      "expected_pending": []
    }
  ],
  "diff_review": {
    "reviewed_exclusions": []
  },
  "counterexamples": {
    "path": "testdata/gates/clean-tree-counterexamples-v4.json",
    "required": [
      {
        "id": "conditional-summary-result",
        "observation": "validation is restored only on the continuation proving the exact aliased helper result nil; discarded, overwritten, or mismatched results remain invalid or inconclusive"
      },
      {
        "id": "constructor-success-edge",
        "observation": "the else-edge return retains the object obligation and is a violation or blocking inconclusive"
      },
      {
        "id": "directive-validation",
        "observation": "one deterministic actionable unknown-directive diagnostic is emitted before any directive consumer runs"
      },
      {
        "id": "false-credit-category-evidence",
        "observation": "credit is accepted only when producer-emitted executed observations contain the claimed category, boundary, stages, dimensions, properties, and populations"
      },
      {
        "id": "hard-coded-subgate-populations",
        "observation": "the subgate fails before success unless every manifest member exists and is uniquely observed in the current run"
      },
      {
        "id": "imported-fact-shape",
        "observation": "the entire relevant fact is rejected and dependent analysis becomes blocking inconclusive"
      },
      {
        "id": "incomplete-diff-proof",
        "observation": "materialization and freshness verification fail until one v3 record binds the complete intended diff, all ledgers, artifacts, observations, and archive order"
      },
      {
        "id": "noncausal-mutation-attribution",
        "observation": "the mutant is invalid unless a structured observation proves the declared semantic mismatch after clean controls and exact restoration"
      },
      {
        "id": "package-stored-literal",
        "observation": "the package initializer literal is analyzed exactly once even without a visible call, or emits blocking inconclusive if its procedure identity is unresolved"
      },
      {
        "id": "post-validation-escape",
        "observation": "mutable escape invalidates proof or is blocking inconclusive; an alias-free immutable copy preserves validation"
      },
      {
        "id": "preclassification-suppression",
        "observation": "classification occurs first and the inconclusive diagnostic remains always visible"
      },
      {
        "id": "stable-id-global-identity",
        "observation": "IDs remain layout-stable, differ across full import paths, and collisions or duplicate emissions fail before baseline write"
      }
    ]
  },
  "commands": [
    {
      "name": "lint",
      "args": [
        "make",
        "lint"
      ],
      "timeout_minutes": 40
    },
    {
      "name": "build",
      "args": [
        "make",
        "build-goplint"
      ],
      "timeout_minutes": 20
    },
    {
      "name": "module-tests",
      "args": [
        "go",
        "test",
        "-count=1",
        "-timeout=25m",
        "./..."
      ],
      "timeout_minutes": 40
    },
    {
      "name": "tidy-diff",
      "args": [
        "go",
        "mod",
        "tidy",
        "-diff"
      ],
      "timeout_minutes": 10
    },
    {
      "name": "scheduled-fuzz",
      "args": [
        "make",
        "check-goplint-fuzz-scheduled"
      ],
      "timeout_minutes": 30
    },
    {
      "name": "exceptions",
      "args": [
        "make",
        "check-goplint-exceptions"
      ],
      "timeout_minutes": 20
    },
    {
      "name": "windows-build",
      "args": [
        "make",
        "check-windows-build"
      ],
      "timeout_minutes": 20
    },
    {
      "name": "license",
      "args": [
        "make",
        "license-check"
      ],
      "timeout_minutes": 10
    },
    {
      "name": "file-length",
      "args": [
        "make",
        "check-file-length"
      ],
      "timeout_minutes": 10
    },
    {
      "name": "docs-guard",
      "args": [
        "make",
        "check-goplint-docs"
      ],
      "timeout_minutes": 10
    },
    {
      "name": "soundness-semantic",
      "args": [
        "make",
        "check-goplint-soundness-semantic"
      ],
      "timeout_minutes": 180
    }
  ],
  "aggregate_report": {
    "command_name": "soundness-semantic",
    "output_file": "soundness-semantic.json",
    "manifest_path": "spec/soundness-gate.v1.json",
    "registry_path": "spec/semantic-evidence.v2.json",
    "profile": "semantic"
  },
  "mutation_proofs": [
    {
      "name": "missing-constructor-validate",
      "observation": "missing-constructor-validate.mutation"
    },
    {
      "name": "missing-constructor-validate-inconclusive",
      "observation": "missing-constructor-validate-inconclusive.mutation"
    },
    {
      "name": "unvalidated-boundary-request",
      "observation": "unvalidated-boundary-request.mutation"
    },
    {
      "name": "unvalidated-cast",
      "observation": "unvalidated-cast.mutation"
    },
    {
      "name": "unvalidated-cast-inconclusive",
      "observation": "unvalidated-cast-inconclusive.mutation"
    },
    {
      "name": "use-before-validate-cross-block",
      "observation": "use-before-validate-cross-block.mutation"
    },
    {
      "name": "use-before-validate-inconclusive",
      "observation": "use-before-validate-inconclusive.mutation"
    },
    {
      "name": "use-before-validate-same-block",
      "observation": "use-before-validate-same-block.mutation"
    }
  ]
}
