{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/invowk/invowk/tools/goplint/testdata/gates/clean-tree-v4.schema.json",
  "title": "goplint clean-tree evidence plan v4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "ownership_manifest_path",
    "inputs",
    "toolchain",
    "task_ledgers",
    "diff_review",
    "counterexamples",
    "commands",
    "aggregate_report",
    "mutation_proofs"
  ],
  "properties": {
    "format_version": {
      "const": 4
    },
    "ownership_manifest_path": {
      "$ref": "#/$defs/repository_path"
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/named_path"
      }
    },
    "toolchain": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "command",
          "required_version_re"
        ],
        "properties": {
          "name": {
            "$ref": "#/$defs/nonempty"
          },
          "command": {
            "$ref": "#/$defs/command_vector"
          },
          "required_version_re": {
            "$ref": "#/$defs/nonempty"
          }
        }
      }
    },
    "task_ledgers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/task_ledger"
      }
    },
    "diff_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewed_exclusions"
      ],
      "properties": {
        "reviewed_exclusions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "reason"
            ],
            "properties": {
              "path": {
                "$ref": "#/$defs/repository_path"
              },
              "reason": {
                "$ref": "#/$defs/nonempty"
              }
            }
          }
        }
      }
    },
    "counterexamples": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "required"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/repository_path"
        },
        "required": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "observation"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/nonempty"
              },
              "observation": {
                "$ref": "#/$defs/nonempty"
              }
            }
          }
        }
      }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "args",
          "timeout_minutes"
        ],
        "properties": {
          "name": {
            "$ref": "#/$defs/nonempty"
          },
          "directory": {
            "$ref": "#/$defs/repository_path"
          },
          "args": {
            "$ref": "#/$defs/command_vector"
          },
          "timeout_minutes": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "aggregate_report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command_name",
        "output_file",
        "manifest_path",
        "registry_path",
        "profile"
      ],
      "properties": {
        "command_name": {
          "$ref": "#/$defs/nonempty"
        },
        "output_file": {
          "type": "string",
          "minLength": 6,
          "pattern": "^[^/\\\\]+\\.json$"
        },
        "manifest_path": {
          "$ref": "#/$defs/repository_path"
        },
        "registry_path": {
          "$ref": "#/$defs/repository_path"
        },
        "profile": {
          "const": "semantic"
        }
      }
    },
    "mutation_proofs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "observation"
        ],
        "properties": {
          "name": {
            "$ref": "#/$defs/nonempty"
          },
          "observation": {
            "$ref": "#/$defs/nonempty"
          }
        }
      }
    }
  },
  "$defs": {
    "nonempty": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "repository_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^/\\\\][^\\\\]*$"
    },
    "named_path": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "path"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/nonempty"
        },
        "path": {
          "$ref": "#/$defs/repository_path"
        }
      }
    },
    "command_vector": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/nonempty"
      }
    },
    "task_ledger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "path",
        "expected_pending"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "path": {
          "type": "string",
          "pattern": "^(?:openspec/changes/(?:archive/[0-9]{4}-[0-9]{2}-[0-9]{2}-)?|docs/ledgers/(?:archive/[0-9]{4}-[0-9]{2}-[0-9]{2}-)?)[a-z0-9][a-z0-9-]*/tasks\\.md$"
        },
        "expected_pending": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9]+(\\.[0-9]+)?$"
          }
        }
      }
    }
  }
}